#!/bin/sh

# 1. 保護ブランチへの直接プッシュを防ぐ
protected_branch="main"
current_branch=$(git symbolic-ref --short HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
    echo "====================================================="
    echo "警告: $protected_branch ブランチへ直接プッシュすることはできません。"
    echo "作業用の機能ブランチからプルリクエストを作成してください。"
    echo "====================================================="
    exit 1
fi

# 2. プッシュ前に自動でテストを走らせる
echo "プッシュ前にテストを自動実行しています..."
php artisan test

# テスト実行コマンドのステータスコードを確認
if [ $? -ne 0 ]; then
    echo "====================================================="
    echo "警告: テストが失敗したため、プッシュをキャンセルしました。"
    echo "コードを修正してから再度プッシュしてください。"
    echo "====================================================="
    exit 1
fi

echo "テスト成功。プッシュを継続します。"
exit 0
